{
  "manifest_version": 3,
  "name": "QuickLaunch Dock",
  "version": "1.0.0",
  "description": "浏览器边缘快捷启动栏，支持自定义 URL 协议一键直达本地软件与常用链接。",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "QuickLaunch Dock（Alt+Q）",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Q"
      },
      "description": "打开 QuickLaunch Dock 快捷浮窗"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "shared/protocol.js",
        "shared/store.js",
        "shared/styles.js",
        "shared/panel.js",
        "content/dock.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
